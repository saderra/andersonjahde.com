{% from "components/practice-area/icon.njk" import icon %}
{% if services and services.length %}
<div class="bg-white">
    <div class="container py-14 md:py-16">
        <div class="text-center mb-8 md:mb-10">
            <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-accent font-semibold mb-2">How We Help</p>
            <h2 class="font-display text-2xl md:text-3xl font-semibold text-stone-900">What We Do For You</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-8">
            {% for item in services %}
            <div class="basis-full sm:basis-[calc(50%-1rem)] lg:basis-[calc(33.333%-1.334rem)] bg-white p-8 border border-stone-100 shadow-sm hover:shadow-xl hover:-translate-y-1 rounded-xl flex flex-col transition-all duration-300">
                {% if item.icon %}
                <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 text-accent mb-5">
                    {{ icon(item.icon, "w-6 h-6") }}
                </div>
                {% endif %}
                <h3 class="font-display text-xl font-semibold text-stone-900 mb-3">{{ item.title }}</h3>
                <p class="text-stone-600 leading-7 flex-1">{{ item.description }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

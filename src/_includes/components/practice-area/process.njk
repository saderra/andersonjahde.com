{% if process and process.length %}
<div class="bg-stone-50">
    <div class="container py-14 md:py-16">
        <div class="text-center mb-8 md:mb-10">
            <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-accent font-semibold mb-2">Our Process</p>
            <h2 class="font-display text-2xl md:text-3xl font-semibold text-stone-900">What Happens Next</h2>
        </div>
        <div class="max-w-3xl mx-auto grid gap-6">
            {% for step in process %}
            <div class="flex gap-5 bg-white p-6 md:p-7 border border-stone-100 shadow-sm rounded-xl">
                <div class="flex-shrink-0 flex items-center justify-center w-11 h-11 rounded-full bg-accent text-white font-display font-semibold text-lg">
                    {{ loop.index }}
                </div>
                <div>
                    <h3 class="font-display text-lg font-semibold text-stone-900 mb-1.5">{{ step.title }}</h3>
                    <p class="text-stone-600 leading-7">{{ step.description }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

{% if site.recaptcha.siteKey %}
<script src="https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoad&render=explicit" async defer></script>
<script>
  function onRecaptchaLoad() {
    ['recaptcha-sidebar', 'recaptcha-contact'].forEach(function (id) {
      if (document.getElementById(id)) {
        grecaptcha.render(id, { sitekey: '{{ site.recaptcha.siteKey }}' });
      }
    });
  }

  function renderModalRecaptcha() {
    var el = document.getElementById('recaptcha-modal');
    if (!el || el.dataset.rendered || typeof grecaptcha === 'undefined' || !grecaptcha.render) return;
    window.modalRecaptchaWidgetId = grecaptcha.render('recaptcha-modal', { sitekey: '{{ site.recaptcha.siteKey }}' });
    el.dataset.rendered = 'true';
  }

  function resetModalRecaptcha() {
    if (typeof grecaptcha !== 'undefined' && typeof window.modalRecaptchaWidgetId !== 'undefined') {
      grecaptcha.reset(window.modalRecaptchaWidgetId);
    }
  }
</script>
{% endif %}

<div class="relative shadow-inner bg-home-cover bg-top bg-cover pt-44 pb-16 px-2 sm:px-6 md:px-20 md:pt-56 md:pb-[239px] lg:pt-[360px] xl:px-24 xl:pb-[216px] text-white font-normal">
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/10"></div>

    <div class="container relative z-10">

        <div class="max-w-3xl bg-black/40 backdrop-blur-sm rounded-xl px-5 py-6 md:px-8 md:py-8 inline-block">

            <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-white/80 font-semibold mb-4">{{ site.tagline }} &middot; Since 1995</p>

            <h1 class="font-display text-4xl md:text-5xl xl:text-6xl font-semibold leading-tight">
                Welcome to {{ site.title }}
            </h1>

            <p class="text-base md:text-lg leading-7 md:leading-8 tracking-wide mt-6 max-w-2xl text-white/90">
                {{ site.homeIntro }}
            </p>

        </div>

        <div class="flex flex-wrap items-center gap-6 mt-10">
            <a href="/contact/" class="inline-flex items-center justify-center px-8 py-4 bg-accent hover:bg-accent-dark text-white font-medium rounded-md transition-colors">
                Schedule a Consultation
            </a>
            <a href="tel:{{ site.author.phoneHref }}" class="inline-flex items-center gap-2 text-white hover:text-white/80 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                {{ site.author.phone }}
            </a>
        </div>

    </div>
</div>

<div class="col-span-12">
    <div class="mb-8 md:mb-10 max-w-2xl mx-auto text-center">
        <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-accent font-semibold mb-2">Our Team</p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold text-stone-900">Attorneys You Can Trust</h2>
        <p class="text-stone-600 mt-3">Experienced tax counsel, including former IRS trial lawyers.</p>
    </div>

    {% set previewAttorneys = collections.attorneys | sort(false, false, 'data.order') %}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        {%- for member in previewAttorneys.slice(0, 4) -%}
        {% include "components/attorneys/card.njk" %}
        {%- endfor -%}
    </div>

    <div class="mt-10 text-center">
        <a href="/attorneys/" class="group inline-flex items-center gap-1.5 px-4 py-2 border border-accent text-sm font-medium rounded-md text-accent hover:bg-accent hover:text-white transition-colors duration-300">
            Meet All Our Attorneys
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
        </a>
    </div>
</div>

{% set sbheader = "font-display font-semibold pb-4 border-b border-stone-300 mb-6 text-2xl text-stone-900" %}
{% set sbcard = "p-8 bg-neutral-50 rounded-md mb-8 shadow-sm" %}

<div class="col-span-12 lg:col-span-4" id="sidebar">

    <div class="{{ sbcard }}">
    <h2 class="{{ sbheader }}">Scheduling</h2>
    {% include "components/global/appointment.njk" %}

    </div>





        {% if hideIntro != true %}
        <div class="{{ sbcard }}">
            <h2 class="{{ sbheader }}">About {{ site.author.firstName }}</h2>
            <p class="leading-7 mb-0 pr-6 text-stone-700">{{ site.sidebarintro }}</p>
        </div>
        {% endif %}










         <div class="{{ sbcard }}">
            <h2 class="{{ sbheader }}">Article Topics</h2>
            <ul>
                {%- for cat in collections.getCat -%}
                    <li class="block"> 
                        <a href="/articles/categories/{{ cat | slug }}" class="inline-block capitalize p-4 text-center text-neutral-600 w-full rounded-md my-2 border border-neutral-200 hover:bg-neutral-100/50 font-medium"> {{ cat | title }} </a>
                    </li>
                {%- endfor -%} 
            </ul>
        </div>









</div>
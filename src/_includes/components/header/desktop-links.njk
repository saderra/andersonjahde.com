<div class="items-center hidden lg:flex">
    {% set navPages = collections.all | eleventyNavigation %}
    {% macro renderNavListItem(entry, level=0) %}
    {% set isHomepage = entry.url == '/' %}
    {% set isActive = entry.url == page.url %}
    {% set liBase = "inline-block float-left" if level == 0 else "border-b border-neutral-200 [&:nth-child(odd)]:border-r hover:bg-stone-200 transition-colors duration-200" %}
    {% set aBase = "relative inline-block py-6 ml-6 lg:ml-9 text-sm font-semibold tracking-[0.1em] uppercase transition-colors duration-200 hover:text-accent after:content-[''] after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-accent after:transition-all after:duration-300" if level == 0 else "block pl-6 pr-8 py-3 whitespace-nowrap text-sm normal-case tracking-normal font-medium" %}
        <li class="{{ liBase }}{% if entry.children.length %} group{% endif %}">
            <a href="{{ entry.url | url }}" class="{{ aBase }}{% if level == 0 %}{% if isActive and not isHomepage %} text-accent after:w-full{% else %} after:w-0 hover:after:w-full{% endif %}{% endif %}">
                {{ entry.title }}
            </a>

            {% if entry.children.length %}
                <ul class="absolute hidden group-hover:grid z-50 shadow-md bg-neutral-50 border-t border-neutral-200 text-sm text-neutral-700 rounded-lg overflow-hidden grid-cols-[repeat(2,max-content)] w-max">
                {% for child in entry.children %}
                    {{ renderNavListItem(child, level + 1) }}
                {% endfor %}
                </ul>
            {% endif %}
        </li>
    {% endmacro %}
    <ul class="text-base font-medium {% if layout == 'home' %}text-white{% else %}text-neutral-700{% endif %}">
        {%- for entry in navPages %}
            {{ renderNavListItem(entry) }}
        {%- endfor -%}

    </ul>
</div>


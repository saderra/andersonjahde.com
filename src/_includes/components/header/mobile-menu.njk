{#- Mobile navigation list. Built from the same eleventyNavigation data as the desktop nav.
    The current page gets aria-current + .is-current, and a section containing the current
    page starts open so the visitor sees where they are. Only one section is open at a time. -#}
<ul class="offcanvas-list" id="mobile-menu">
  {%- set navPages = collections.all | eleventyNavigation %}
  {%- for entry in navPages %}
    {%- if entry.children.length %}
      {%- set hasCurrent = false %}
      {%- for child in entry.children %}{% if child.url == page.url %}{% set hasCurrent = true %}{% endif %}{% endfor %}
      {%- set sectionOpen = hasCurrent or entry.url == page.url %}
      <li data-accordion
          x-data="{ sub: {{ 'true' if sectionOpen else 'false' }} }"
          :class="{ 'is-open': sub }"
          @offcanvas-accordion.window="if ($event.detail !== {{ loop.index }}) sub = false"
          {% if sectionOpen %}class="is-open"{% endif %}>
        <div class="offcanvas-row{% if entry.url == page.url %} is-current{% endif %}">
          <a href="{{ entry.url | url }}" class="offcanvas-link"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a>
          <button type="button" class="offcanvas-toggle"
                  @click="sub = !sub; if (sub) $dispatch('offcanvas-accordion', {{ loop.index }})"
                  :aria-expanded="sub"
                  aria-expanded="{{ 'true' if sectionOpen else 'false' }}"
                  aria-controls="mobile-sub-{{ loop.index }}">
            <span class="sr-only">Toggle {{ entry.title }} submenu</span>
            <svg class="accordion-chevron h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </button>
        </div>
        <div class="accordion-panel" id="mobile-sub-{{ loop.index }}">
          <ul class="offcanvas-sublist">
            {%- for child in entry.children %}
            <li><a href="{{ child.url | url }}" class="offcanvas-sublink{% if child.url == page.url %} is-current{% endif %}"{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
            {%- endfor %}
          </ul>
        </div>
      </li>
    {%- else %}
      <li>
        <div class="offcanvas-row{% if entry.url == page.url %} is-current{% endif %}">
          <a href="{{ entry.url | url }}" class="offcanvas-link"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a>
        </div>
      </li>
    {%- endif %}
  {%- endfor %}
</ul>

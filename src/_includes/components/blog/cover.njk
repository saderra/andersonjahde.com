{% if post.data.coverImage %}
<a href="{{ post.url }}">
    {{ post.data.coverImage | renderImage({ alt: post.data.title + " cover image", sizes: "(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw", loading: "lazy", decoding: "async", class: "w-auto mb-4 md:mb-6 rounded-md" }) | safe }}
</a>
{% endif %}
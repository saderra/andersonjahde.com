{% if post.data.title  %} 
    {% set articleTitle = post.data.title %}
{% else %}
    {% set articleTitle = title %}
{% endif  %} 

<h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-stone-900 m-0 p-0 pb-2">
    <a href="{{ post.url }}" class="no-underline">{{ articleTitle }}</a>
</h2>
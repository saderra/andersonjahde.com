{% if post.data.title  %} 
    {% set articleTitle = post.data.title %}
{% else %}
    {% set articleTitle = title %}
{% endif  %} 

<h2 class="text-3xl md:text-4xl tracking-tight text-stone-700 m-0 p-0 pb-2">
    <a href="{{ post.url }}" class="no-underline font-medium">{{ articleTitle }}</a>
</h2>
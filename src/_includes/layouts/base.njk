<!DOCTYPE html>
<html lang="en">
{% include "components/head/head.njk" %}
<body x-data="{ open: false, consultOpen: false, consultSubmitting: false, consultSubmitted: false, consultError: false }" {% if layout %}class="{{ layout }} {{ bodyClass }}"{% endif %}>
{% include "components/header/header.njk" %}

<section class="bg-neutral-50">
   {% block mainContent %}{% endblock %}
</section>

{% include "components/footer/footer.njk" %}

<script>
  // Validate Netlify form fields beyond the browser's built-in checks:
  //  - reject Cyrillic characters in any field, since nearly all of the site's
  //    form spam is Russian-language;
  //  - reject a required textarea (the "How can we help?" message) that holds
  //    only whitespace, which the native `required` attribute would accept.
  // Uses native form validation so the browser blocks the submit and shows the
  // message; the fetch-based modal form is covered too because its submit event
  // only fires once validation passes. Bots that POST directly to Netlify
  // bypass this (client-side only); the honeypot field on each form is for them.
  (function () {
    var cyrillic = /\p{Script=Cyrillic}/u;
    var selector = "form[data-netlify] input, form[data-netlify] textarea";
    function check(el) {
      if (!el.matches || !el.matches(selector)) return;
      var message = "";
      if (cyrillic.test(el.value)) {
        message = "Please use only English (Latin) characters.";
      } else if (el.tagName === "TEXTAREA" && el.required && el.value.trim() === "") {
        message = "Please tell us how we can help.";
      }
      el.setCustomValidity(message);
    }
    document.addEventListener("input", function (e) { check(e.target); });
    document.addEventListener("submit", function (e) {
      var fields = e.target.querySelectorAll ? e.target.querySelectorAll("input, textarea") : [];
      fields.forEach(check);
      if (e.target.matches && e.target.matches("form[data-netlify]") && !e.target.checkValidity()) {
        e.preventDefault();
        e.stopImmediatePropagation();
        e.target.reportValidity();
      }
    }, true);
  })();
</script>

<script>
  if (/[#&](confirmation_token|invite_token|recovery_token|email_change_token)=/.test(window.location.hash)) {
    var identityScript = document.createElement("script");
    identityScript.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
    identityScript.onload = function () {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/cms/";
          });
        }
      });
    };
    document.head.appendChild(identityScript);
  }
</script>

</body>
</html>
{% extends "layouts/base.njk" %}
{% block mainContent %}
{% from "components/practice-area/icon.njk" import icon %}

<div class="bg-stone-100">
    <div class="container pt-10 pb-16 md:pt-16 md:pb-20 text-center">
        <a href="{{ '/' | url }}" class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.15em] text-stone-500 hover:text-accent transition-colors duration-200 mb-6">
            &larr; Back to Home
        </a>

        <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-accent font-semibold mb-3">404 Error</p>

        <h1 class="font-display text-4xl md:text-5xl font-semibold text-stone-900 max-w-3xl mx-auto leading-tight">{{ title }}</h1>

        <p class="text-stone-600 text-lg leading-8 mt-6 max-w-2xl mx-auto">Sorry, we can&rsquo;t find the page you&rsquo;re looking for. It may have been moved, renamed, or the link may be out of date.</p>

        <div class="flex flex-wrap items-center justify-center gap-6 mt-8 lg:hidden">
            <button type="button" @click="consultOpen = true" class="inline-flex items-center justify-center px-8 py-4 bg-accent hover:bg-accent-dark text-white font-medium rounded-md transition-colors">
                Schedule a Consultation
            </button>
            <a href="tel:{{ site.author.phoneHref }}" class="inline-flex items-center gap-2 text-stone-700 hover:text-accent font-medium transition-colors">
                {{ icon("phone", "w-5 h-5") }}
                {{ site.author.phone }}
            </a>
        </div>
    </div>
</div>

<div class="bg-white">
    <div class="container py-14 md:py-16">
        <div class="text-center mb-8 md:mb-10">
            <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-accent font-semibold mb-2">Find Your Way</p>
            <h2 class="font-display text-2xl md:text-3xl font-semibold text-stone-900">Where Would You Like to Go?</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-8">

            <a href="{{ '/practice-areas/' | url }}" class="group basis-full sm:basis-[calc(50%-1rem)] lg:basis-[calc(25%-1.5rem)] bg-white p-8 border border-stone-100 shadow-sm hover:shadow-xl hover:-translate-y-1 rounded-xl flex flex-col transition-all duration-300">
                <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 text-accent mb-5">
                    {{ icon("scale", "w-6 h-6") }}
                </div>
                <h3 class="font-display text-xl font-semibold text-stone-900 mb-3">Practice Areas</h3>
                <p class="text-stone-600 leading-7 flex-1">Explore the tax, estate, and litigation services we offer.</p>
                <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-5 group-hover:gap-2 transition-all duration-300">View Practice Areas &rarr;</span>
            </a>

            <a href="{{ '/attorneys/' | url }}" class="group basis-full sm:basis-[calc(50%-1rem)] lg:basis-[calc(25%-1.5rem)] bg-white p-8 border border-stone-100 shadow-sm hover:shadow-xl hover:-translate-y-1 rounded-xl flex flex-col transition-all duration-300">
                <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 text-accent mb-5">
                    {{ icon("users", "w-6 h-6") }}
                </div>
                <h3 class="font-display text-xl font-semibold text-stone-900 mb-3">Our Attorneys</h3>
                <p class="text-stone-600 leading-7 flex-1">Meet the tax attorneys who will handle your case.</p>
                <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-5 group-hover:gap-2 transition-all duration-300">Meet the Team &rarr;</span>
            </a>

            <a href="{{ '/articles/' | url }}" class="group basis-full sm:basis-[calc(50%-1rem)] lg:basis-[calc(25%-1.5rem)] bg-white p-8 border border-stone-100 shadow-sm hover:shadow-xl hover:-translate-y-1 rounded-xl flex flex-col transition-all duration-300">
                <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 text-accent mb-5">
                    {{ icon("document-text", "w-6 h-6") }}
                </div>
                <h3 class="font-display text-xl font-semibold text-stone-900 mb-3">Articles</h3>
                <p class="text-stone-600 leading-7 flex-1">Read our latest tax law articles and IRS updates.</p>
                <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-5 group-hover:gap-2 transition-all duration-300">Read Articles &rarr;</span>
            </a>

            <a href="{{ '/contact/' | url }}" class="group basis-full sm:basis-[calc(50%-1rem)] lg:basis-[calc(25%-1.5rem)] bg-white p-8 border border-stone-100 shadow-sm hover:shadow-xl hover:-translate-y-1 rounded-xl flex flex-col transition-all duration-300">
                <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 text-accent mb-5">
                    {{ icon("envelope", "w-6 h-6") }}
                </div>
                <h3 class="font-display text-xl font-semibold text-stone-900 mb-3">Contact Us</h3>
                <p class="text-stone-600 leading-7 flex-1">Send us a message and we&rsquo;ll get back to you.</p>
                <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-5 group-hover:gap-2 transition-all duration-300">Get in Touch &rarr;</span>
            </a>

        </div>
    </div>
</div>

{% include "components/home/cta.njk" %}

{% endblock %}

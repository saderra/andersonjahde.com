{% extends "layouts/base.njk" %}
{% block mainContent %}
      <div class="container grid gap-0 lg:gap-10 grid-cols-12 pt-8">
        <div class="p-0 col-span-12 lg:col-span-8">          
           <article class="prose max-w-full p-6 md:p-8 bg-white shadow-sm rounded-md mb-8 prose-a:no-underline">

                {% if coverImage %}
                {{ coverImage | renderImage({ alt: title + " cover image", sizes: "(min-width: 1024px) 760px, 100vw", loading: "eager", decoding: "async", fetchpriority: "high", class: "rounded-md" }) | safe }}
                {% endif %}

                <div class="bg-stone-50 p-5 md:p-8 rounded-md shadow-inner">

                    <h1 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-stone-900 m-0 p-0 pb-2">{{ title }}</h1>


                    <div class="mt-4">

                    {{ content | safe }}

        
            
                </div>
            </article>
        </div>     
        {% include "components/section/sidebar.njk" %}
    </div>

{% endblock %}



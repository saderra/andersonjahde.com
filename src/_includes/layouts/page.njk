{% extends "layouts/base.njk" %}
{% block mainContent %}

    <div class="container grid gap-0 lg:gap-10 grid-cols-12 pt-8">
        <div class="p-0 col-span-12 lg:col-span-8">
           <article class="max-w-full p-8 lg:p-12 bg-white shadow-sm rounded-md mb-8">
            <div class="prose max-w-[96%] prose-a:no-underline prose-a:font-semibold prose-a:text-fuchsia-800 prose-h2:font-medium prose-h2:text-2xl prose-h2:border-b prose-h2:clear-both prose-h2:py-4 prose-h3:font-medium prose-h3:text-xl prose-h3:p-0 prose-h3:m-0 prose-h3:pb-4">
               <h1 class="font-display text-3xl md:text-4xl pb-8 mb-8 border-b border-stone-200 font-semibold text-stone-900">
                {% if contentTitle %}
                    {{ contentTitle }}
                {% else %}
                    {{ title }}
                {% endif %}
                </h1>
                {{ content | safe }}
                </div>
                {% if showContactForm == true %}
                    {% include "components/forms/general-contact.njk" %}
                {% endif %}
            </article>
        </div>
            {% include "components/section/sidebar.njk" %}
        </div>

{% endblock %}


